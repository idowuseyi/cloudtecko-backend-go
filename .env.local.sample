# This is a dotenv file.
# Syntax Overview: https://hexdocs.pm/dotenvy/dotenv-file-format.html
# Parser: github.com/subosito/gotenv

# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
#                         DO NOT USE IN PRODUCTION!
#                    DO NOT COMMIT INTO VERSION CONTROL!
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!

# Why?
# Use .env.local to easily inject secrets into your server config.

# When?
# Only use this locally, never in production.

# What?
# .env.local.sample is only a "sample" and should never hold any secret values!
# .env.local is .gitignored.
# .env.local is automatically loaded when running app <command>.
# .env.local is **not** automatically loaded when running go test / make test.
# .env.local ENV variables override OS ENV variables.
# .env.local is applied by /internal/config's DefaultServiceConfigFromEnv().

# How?
# Copy this file to `.env.local` to use it, e.g. with the following command:
# cp .env.local.sample .env.local

# Be kind to your colleagues and show them which typical ENV **keys** they
# have to set (without setting the actual value within .env.local.sample):
SECRET_KEY=

# -----------------------------------------------------------------------------
# Running WITHOUT Docker (`make run`)
# -----------------------------------------------------------------------------
# Copy this file to .env.local and fill in the values. Keys only here -- this
# file is committed, so it must never hold a real value.
#
# NOTE: .env.local OVERRIDES real ENV variables. docker-compose.yml sets
# DOTENV_DISABLE=true so the container stack ignores this file entirely and keeps
# using its own Postgres; without that guard, credentials below would silently
# redirect the containerised app at your cloud database.

# Connection URL for a managed Postgres (Neon, Aiven, Supabase, Render, RDS...).
# Takes precedence over the discrete PG* variables. Parameters the lib/pq driver
# cannot handle (e.g. Neon's channel_binding) are dropped with a warning.
# Example shape: postgres://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=

# Optional: direct (non-pooled) endpoint used ONLY to apply migrations.
# Set this when DATABASE_URL points at a transaction pooler, which cannot run DDL
# reliably. Defaults to DATABASE_URL when unset.
MIGRATION_DATABASE_URL=

# Required off-Docker. `make go-build` puts the binary in ./bin, and the app
# otherwise resolves migrations/, web/templates, web/i18n and api/swagger.yml
# relative to the binary. The `make run*` targets already export this for you;
# set it only if you invoke ./bin/app directly.
# PROJECT_ROOT_DIR=

# Management endpoint secret. If unset, a random one is generated per process,
# which means it changes on every restart.
SERVER_MANAGEMENT_SECRET=

# Where this API is reachable, and the frontend it links to in emails.
# SERVER_ECHO_LISTEN_ADDRESS=:8080
# SERVER_ECHO_BASE_URL=http://localhost:8080
# SERVER_FRONTEND_BASE_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins. Leave unset to disable CORS.
# SERVER_ECHO_CORS_ALLOW_ORIGINS=

# Mail: "mock" keeps mails in memory, "SMTP" actually sends.
# SERVER_MAILER_TRANSPORTER=mock
# SERVER_SMTP_HOST=
# SERVER_SMTP_PORT=
SERVER_SMTP_USERNAME=
SERVER_SMTP_PASSWORD=

# Connection pool. Keep MAX_OPEN low on serverless/pooled endpoints.
# DB_MAX_OPEN_CONNS=
# DB_MAX_IDLE_CONNS=

# -----------------------------------------------------------------------------
# Auth and registration
# -----------------------------------------------------------------------------

# Require email confirmation before a registration becomes an account.
#
# SET THIS TO true IN PRODUCTION. With it false, /api/v1/auth/register answers a
# NEW address with a session and an EXISTING address without one -- and that
# difference discloses whether an address already has an account (security audit
# S-020). Requiring confirmation collapses both to the same response. The server
# logs a warning at startup when this is false.
# SERVER_AUTH_REGISTRATION_REQUIRES_CONFIRMATION=false

# How long an approved applicant has to accept their membership invitation.
# Longer than a confirmation token because a human admin's approval may land
# while the applicant is away -- but still finite: an unaccepted invitation is a
# standing capability to create an account. Default 7 days.
# SERVER_AUTH_INVITATION_TOKEN_VALIDITY_SECONDS=604800

# Frontend page that collects a password from an approved applicant. The
# invitation link must point at the frontend, not the API: accepting requires
# choosing a password, and a bare API endpoint has nowhere to type one.
# SERVER_FRONTEND_MEMBERSHIP_INVITATION_ENDPOINT=/membership/accept

# -----------------------------------------------------------------------------
# Object storage (media uploads)
# -----------------------------------------------------------------------------
# Production targets Cloudflare R2; any S3-compatible endpoint works.

# Keep uploads in memory instead of calling a real store. Default true, so a
# developer with no credentials still gets a working server. Uploads are lost on
# restart.
# SERVER_STORAGE_USE_MOCK=true

# Host[:port] of the S3 API, WITHOUT a scheme -- e.g.
# <account-id>.r2.cloudflarestorage.com  (use SERVER_STORAGE_USE_SSL for https)
SERVER_STORAGE_ENDPOINT=
SERVER_STORAGE_ACCESS_KEY=
SERVER_STORAGE_SECRET_KEY=
SERVER_STORAGE_BUCKET=

# R2 ignores region but requires a value; "auto" is the convention.
# SERVER_STORAGE_REGION=auto
# SERVER_STORAGE_USE_SSL=true

# Domain that public media is served from.
#
# This MUST be a CDN or bucket custom domain, never this API's own origin.
# Serving user-supplied files same-origin turns any stored-content flaw into a
# same-origin scripting problem against the API itself.
SERVER_STORAGE_PUBLIC_BASE_URL=

# How long an upload URL stays valid. Short is safer: the URL is a bearer
# capability to write into the bucket. Default 15 minutes.
# SERVER_STORAGE_PRESIGN_TTL_SECONDS=900

# Cap enforced at COMPLETION, not at presign -- a presigned PUT cannot constrain
# the size of what the client actually sends, so an oversized object is detected
# after the fact, rejected and deleted. Default 10 MiB.
# SERVER_STORAGE_MAX_UPLOAD_BYTES=10485760

# Allow-list checked against the SNIFFED content type, not the declared one.
# image/svg+xml is deliberately absent: SVG is an XSS vector that passes every
# MIME check because it genuinely is image/svg+xml.
# SERVER_STORAGE_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/webp,image/gif,application/pdf

# Prefixes separating unverified uploads from promoted ones, so a bucket policy
# can keep the quarantine prefix unreadable.
# SERVER_STORAGE_QUARANTINE_PREFIX=quarantine
# SERVER_STORAGE_PUBLIC_PREFIX=public

# -----------------------------------------------------------------------------
# Payments (Paystack)
# -----------------------------------------------------------------------------

# Keep money flows in memory -- no real money moves, and the whole pipeline
# (checkout, webhook, settlement) still runs end to end.
#
# Defaults to FALSE, unlike SERVER_PUSH_USE_MOCK and SERVER_STORAGE_USE_MOCK.
# Those degrade to a harmless no-op when mocked; this one degrades to "anyone who
# can reach /webhooks/payments can forge a settlement", because the mock verifies
# webhook signatures with a key that is by definition known to whoever set it.
# A developer opts in on purpose; a forgotten variable must not opt a deployment
# in. Set BOTH of the next two lines to use it locally.
# SERVER_PAYMENT_USE_MOCK=true

# Signs mock webhook bodies so local runs exercise the REAL signature
# verification path rather than bypassing it.
#
# There is deliberately NO default: a value committed here would be a working
# forgery key for anyone who reads the repository. The server refuses to start
# with the mock enabled and this empty. Any string will do -- it is a local
# development value, not a secret to protect.
# SERVER_PAYMENT_MOCK_SECRET_KEY=pick-any-local-string

# Paystack secret key: sk_test_... for test mode, sk_live_... for production.
#
# This one key does double duty -- it authenticates our API calls AND is the HMAC
# key Paystack signs webhook bodies with (there is no separate webhook secret).
# Required unless SERVER_PAYMENT_USE_MOCK is true -- which is NOT the default --
# and the server refuses to start without it rather than failing at the first
# charge, or worse, not failing at all.
SERVER_PAYMENT_SECRET_KEY=

# SERVER_PAYMENT_BASE_URL=https://api.paystack.co
# SERVER_PAYMENT_REQUEST_TIMEOUT_SECONDS=30

# Where the provider returns the payer after checkout. This is a nice page and
# NOTHING MORE: the redirect is fully attacker-controlled, so fulfilment happens
# on the signed webhook (or a server-to-server verify), never on the return.
# SERVER_PAYMENT_CALLBACK_URL=http://localhost:3000/payment/complete

# -----------------------------------------------------------------------------
# Community forms and data retention
# -----------------------------------------------------------------------------

# Per-email window inside which a second contact submission is silently dropped.
# Silently, because answering "you submitted too recently" would confirm that an
# address has used the form. Default 5 minutes.
# SERVER_COMMUNITY_CONTACT_THROTTLE_SECONDS=300

# Retention windows, written into purge_after when a row is created. Both tables
# hold names, email addresses and free text -- personal data under the NDPA 2023
# -- so the schema refuses a row without an expiry. `app db purge-expired`
# HARD-deletes past it; run it on a schedule. Defaults: 1 year, 2 years.
# SERVER_COMMUNITY_CONTACT_RETENTION_SECONDS=31536000
# SERVER_COMMUNITY_APPLICATION_RETENTION_SECONDS=63072000
