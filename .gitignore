# based on https://github.com/github/gitignore/blob/master/Go.gitignore

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# GOBIN
bin

# local go mod cache
.pkg

# temporary files
tmp

# mac specific
.DS_Store

# directory for rw files (PV mounted into the container)
# /assets/mnt folder should stay gitignored!
assets/mnt/**
!assets/mnt/.gitkeep
dumps

# go debug / delve
__debug_bin

# we support overloading ENV vars by parsing a dotenv formatted file
# this file can be used for local testing (secrets!) but should never be commited into git
.env.local

# the postAttachCommand should clean this up, ensure it's not commited anyway
.gitconfig.global
# --- cloudtecko additions ---

# dotenv files: only .env.local.sample is committed, never a real one.
# The upstream template ignored the single literal name ".env.local"; any
# other dotenv file (.env, .env.production, ...) was tracked by accident.
.env
.env.*
!.env.local.sample

# credentials / keys — never commit these
*.pem
*.key
*.crt
*.p12
*.pfx
service-account*.json

# IDEs
.idea/

# node (web tooling, if any is added later)
node_modules/

# coverage output
coverage.out
coverage.html
